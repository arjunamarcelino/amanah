# docker-compose stack env — NAMES ONLY. Copy to an untracked `.env` on the VPS
# (same directory as docker-compose.yml) and fill in real values. NEVER commit `.env`.
#
#   cp docker-compose.example.env .env   # then edit .env on the VPS
#
# Reminders:
#   - NEXT_PUBLIC_* are inlined into the web/landing images at BUILD time → changing
#     one requires `docker compose up -d --build` (a restart alone keeps stale values).
#   - AGENT_SHARED_SECRET must be identical for web and agent; generate high-entropy:
#       openssl rand -hex 32
#   - DEPLOYER_PRIVATE_KEY is the contract OWNER key (testnet/mock only). Never reuse
#     on mainnet. Only the on-demand `seed` service reads it.

# --- Postgres (volume-backed) ---
POSTGRES_PASSWORD=

# --- api (CORS must be the exact prod web origin, no trailing slash) ---
CORS_ORIGINS=https://app.amanah.help

# --- indexer (lower for the demo so events surface inside the 90s window) ---
INDEXER_CONFIRMATIONS=2

# --- agent (paid key — set a spend cap in the Anthropic console) ---
ANTHROPIC_API_KEY=
AGENT_SHARED_SECRET=

# --- chain / RPC ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- web public build args (baked into the image) ---
NEXT_PUBLIC_APP_URL=https://app.amanah.help
NEXT_PUBLIC_API_URL=https://api.amanah.help
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# --- seed one-shot only (contract owner key; funded Base Sepolia ETH) ---
DEPLOYER_PRIVATE_KEY=
