# Root aggregate of env var NAMES only — never commit real values.
# Per-app example files live alongside each app (apps/*/.env*.example).
# For the dockerized VPS stack, see docker-compose.example.env.

# --- database (apps/api, packages/db, apps/indexer) ---
DATABASE_URL=
# docker-compose Postgres password (loopback-bound). Set a strong value on the VPS.
POSTGRES_PASSWORD=

# --- api (apps/api) ---
CORS_ORIGINS=
PENDING_TTL_MIN=

# --- indexer (apps/indexer) ---
INDEXER_CONFIRMATIONS=
INDEXER_START_BLOCK=

# --- agent (apps/agent) ---
ANTHROPIC_API_KEY=
# The agent calls the api for candidate rails (required by apps/agent config).
API_URL=
# Shared bearer secret gating POST /route (agent is internal-only; callers send this).
# Generate high-entropy: `openssl rand -hex 32`. MUST match web's value.
AGENT_SHARED_SECRET=

# --- web (apps/web) ---
# Server-side only (NOT inlined into the browser bundle): used by app/api/route to
# reach the internal agent over the compose network.
AGENT_URL=
# Public (NEXT_PUBLIC_*): inlined into the client bundle at BUILD time.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_PRIVY_APP_ID=

# --- contracts (packages/contracts) ---
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
