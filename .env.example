# Root aggregate of env var NAMES only — never commit real values.
# Per-app example files live alongside each app (apps/*/.env*.example).

# --- database (apps/api, packages/db, apps/indexer) ---
DATABASE_URL=
# docker-compose Postgres password (loopback-bound). Set a strong value on the VPS.
POSTGRES_PASSWORD=

# --- api (apps/api) ---
CORS_ORIGINS=
PENDING_TTL_MIN=

# --- indexer (apps/indexer) ---
INDEXER_CONFIRMATIONS=
INDEXER_START_BLOCK=

# --- agent (apps/agent) ---
ANTHROPIC_API_KEY=

# --- web (apps/web, public) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AGENT_URL=
NEXT_PUBLIC_PRIVY_APP_ID=

# --- contracts (packages/contracts) ---
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
