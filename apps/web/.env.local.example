# @amanah/web — public env (names only). Copy to .env.local and fill in.
# Read by the app today:
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# Reserved (not read by the app yet — wired in later prompts):
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_AGENT_URL=
# Base Sepolia RPC. Optional — falls back to the public DEFAULT_RPC_URL from
# @amanah/shared. If set to a keyed provider, use an origin-restricted key.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
