# @amanah/agent — AI off-ramp router (names only). Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Internal base URL of apps/api (server-to-server; e.g. http://api:4000 in compose).
API_URL=http://localhost:4000
# Shared bearer secret required on POST /route. Callers (api/web) must send the same value.
AGENT_SHARED_SECRET=
