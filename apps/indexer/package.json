{
  "name": "@amanah/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Amanah on-chain event indexer (viem) — mirrors Base Sepolia events into Postgres.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@amanah/db": "workspace:*",
    "@amanah/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@amanah/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
