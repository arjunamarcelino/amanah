# @amanah/indexer — viem on-chain event indexer (names only). Copy to .env and fill in.
DATABASE_URL=
# Base Sepolia RPC. A dedicated endpoint is recommended for demo reliability.
BASE_SEPOLIA_RPC_URL=
# Optional: override the backfill start (defaults to the deploy block from @amanah/shared).
INDEXER_START_BLOCK=
# Reorg bound: index up to head - this many blocks.
INDEXER_CONFIRMATIONS=
# Live-poll interval (ms).
INDEXER_POLL_MS=
# Initial backfill chunk size (halves on RPC range/result caps).
INDEXER_CHUNK=
