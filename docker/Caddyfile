# Amanah reverse proxy — one subdomain per service.
# Replace amanah.example with the real domain when provisioning the VPS.

app.amanah.example {
	reverse_proxy web:3000
}

# Apex landing site (becomes amanah.help in production).
amanah.example {
	# Security/response headers — the landing page is a self-contained static
	# marketing site, so the CSP can stay tight (only inline bootstrap script +
	# Next's inline styles are allowed; no external origins).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}
	reverse_proxy landing:80
}

# Canonicalize www → apex with a permanent 308 (becomes www.amanah.help in production).
www.amanah.example {
	redir https://amanah.example{uri} 308
}

api.amanah.example {
	reverse_proxy api:4000
}

# apps/agent is intentionally NOT proxied: the off-ramp router is internal-only
# (reached by api/web over the compose network at http://agent:5000, behind a
# shared-secret bearer gate). Exposing it publicly would make its paid Claude
# calls an unauthenticated denial-of-wallet target.
