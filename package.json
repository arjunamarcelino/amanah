{
  "name": "amanah",
  "version": "0.0.0",
  "private": true,
  "description": "Amanah — on-chain charitable disaster-relief protocol (Base Sepolia).",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "deploy:contracts": "pnpm --filter @amanah/contracts deploy:contracts"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.11.8",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
