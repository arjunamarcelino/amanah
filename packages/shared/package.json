{
  "name": "@amanah/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, types, chain constants, ABIs and addresses.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@amanah/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3"
  }
}
