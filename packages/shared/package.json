{
  "name": "@amanah/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, types, chain constants, ABIs and addresses.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:exports": "attw --pack . && publint",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@amanah/config": "workspace:*",
    "@arethetypeswrong/cli": "^0.18.1",
    "eslint": "^9.17.0",
    "publint": "^0.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
