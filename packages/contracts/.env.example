# packages/contracts — env var NAMES only. NEVER commit real values.
# Copy to packages/contracts/.env (gitignored) and fill in. forge auto-loads .env.

# RPC endpoint for Base Sepolia (chainId 84532). Your own Alchemy/Infura URL is best;
# the public https://sepolia.base.org works but may rate-limit.
BASE_SEPOLIA_RPC_URL=

# DEDICATED testnet-only deployer key. Becomes the perpetual owner of every contract —
# never reuse a key that touches mainnet or any real value. Its address must hold
# Base Sepolia ETH for gas before deploying. Hex, with or without 0x prefix.
DEPLOYER_PRIVATE_KEY=

# OPTIONAL — only for Basescan source verification (deferred; not needed to deploy).
# A single Etherscan V2 multichain key covers Base Sepolia.
ETHERSCAN_API_KEY=
