{
  "name": "@amanah/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma client (PostgreSQL) — offchain operational data only, never financial state.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json && cp -R src/generated dist/generated",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0"
  },
  "devDependencies": {
    "@amanah/config": "workspace:*",
    "@amanah/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "prisma": "^6.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
