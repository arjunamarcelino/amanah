// Amanah offchain operational data — Prisma schema.
// Source of truth for money stays on-chain; this DB holds operational data only
// (pool metadata, disaster catalog, rail candidates, cached event index, decision logs).
// Models land in later prompts; this is an empty scaffold — DO NOT run migrations yet.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
